[{'source': '寒凝血瘀证', 'relation': '对应常见病及治疗方法：', 'target': '7、厥证\n\n临床见手足厥寒，得暖自复，面色苍白，唇淡，指甲不红，舌质淡，苔薄少，脉细欲绝。治宜养血通阳，散寒救逆，方用当归四逆汤（《伤寒论》）'}, {'source': '寒凝血瘀证', 'relation': '对应常见病及治疗方法：', 'target': '6、痛经\n\n临床见经期或经前数日小腹冷痛拒按，得热痛减，按之痛甚，经量少，经色黯黑有块，舌苔白腻，脉沉紧。治宜温经散寒，活血止痛，方用少腹逐瘀汤（《医林改错》）或脱花煎（《景岳全书》).'}, {'source': '寒凝血瘀证', 'relation': '对应常见病及治疗方法：', 'target': '5、月经后期\n\n临床见月经延后，量少或正常，经色暗红，质正常，有血块，小腹冷痛拒按，得热则减。伴面色青白，肢冷畏寒，唇舌色紫，或有瘀点，脉沉紧。治宜温经散寒，活血行滞，方用姜黄散（《证治准绳》）或温经汤（《妇人大全良方》）。'}, {'source': '寒凝血瘀证', 'relation': '对应常见病及治疗方法：', 'target': '4、阴疽\n\n临床见患处漫肿无头，酸痛无热，皮色不变，口中不渴，舌淡暗苔白，脉沉细涩。治宜温阳散寒，活血通滞，方用阳和汤（《外科全生集》）。'}, {'source': '寒凝血瘀证', 'relation': '对应常见病及治疗方法：', 'target': '3、胸痹心痛\n\n临床见胸痛胸闷，心痛彻背，背痛彻心，四肢厥冷，喜暖喜温，面色紫暗灰滞，爪甲、面色青紫，脉沉紧，或结代，舌质青紫。治宜扶阳通痹，活血化瘀，方用赤石脂丸（《金匮要略》）加元胡、川芎等。'}, {'source': '寒凝血瘀证', 'relation': '对应常见病及治疗方法：', 'target': '2、皮痹\n\n临床见皮肤坚硬而肿，皮肤不温，肢寒恶冷，遇寒加重，如革，肤色暗滞，肌肉瘦削，关节疼痛怕冷，强直，或畸形，屈伸不利，胸背紧束，舌质暗，舌上瘀斑。治宜散发活血，方用防风汤（《圣济总录》）合身痛逐瘀汤（《医林改错》）。'}, {'source': '寒凝血瘀证', 'relation': '对应常见病及治疗方法：', 'target': '1、脉痹\n\n临床见患肢发凉，麻木、疼痛较甚，日重夜轻，皮肤苍白，或潮红，紫瘀，甚至皮肤干燥脱屑，破裂，汗毛脱落，少汗或无汗，指（趾）甲增厚、脆硬、变形，肌肉萎缩，顽麻不仁，趺阳脉或太溪脉搏动消失，舌质紫瘀苔薄白，脉沉涩。治宜温阳散寒，化瘀止痛，方用当归四逆汤（《金匮要略》）合阳和汤（《外科全生集》）。'}, {'source': '寒凝血瘀证', 'relation': '有症状：', 'target': '脉沉迟等'}, {'source': '寒凝血瘀证', 'relation': '有症状：', 'target': '舌质暗苔白'}, {'source': '寒凝血瘀证', 'relation': '有症状：', 'target': '伴有躯体瘀血的症状'}, {'source': '寒凝血瘀证', 'relation': '有症状：', 'target': '得温痛减'}, {'source': '寒凝血瘀证', 'relation': '有症状：', 'target': '屈伸不利'}, {'source': '寒凝血瘀证', 'relation': '有症状：', 'target': '肌肤畏寒冷痛'}, {'source': '寒凝血瘀证', 'relation': '有症状：', 'target': '肢体'}, {'source': '寒凝血瘀证', 'relation': '的定义是', 'target': '是指寒邪凝滞气机，血行瘀阻，以畏寒冷痛，得温痛减，肢冷色青，妇女月经后期、痛经、经色紫暗夹块，舌紫暗，苔白，脉沉迟而涩等为常见症的证候。常见于脉痹、皮痹、胸痹心痛、阴疽、月经后期、痛经、厥证等疾病中。'}]
