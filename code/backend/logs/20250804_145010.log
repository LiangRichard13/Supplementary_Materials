[{'source': '脾胃湿热证', 'relation': '对应常见病及治疗方法：', 'target': '4、鼓胀\n\n因湿热互结于脾胃，浊水停聚而引起，兼见烦热口苦，渴不欲饮，小便赤涩，大便秘结，或有面目皮肤发黄，苔黄膩或灰黑，脉弦数，治疗上应清热利湿，攻下逐水，方选中满分消丸（《兰室秘藏》）加减。'}, {'source': '脾胃湿热证', 'relation': '对应常见病及治疗方法：', 'target': '3、水肿\n\n因水湿内侵，湿蕴于中，脾为湿困，湿邪化热，湿热交蒸，膀胱输化无权导致水肿，症见遍身浮肿，胸腹痞闷，小便短赤，大便干结，苔黄，脉沉数，治当分利湿热，方宜八正散加减（《和剂局方》）。'}, {'source': '脾胃湿热证', 'relation': '对应常见病及治疗方法：', 'target': '2、黄疸\n\n多因酒食过度，水谷相并，积于脾胃，复为风湿所搏，热气郁蒸，所以发黄为疸。症见目黄身黄，头重身困，恶心呕吐，胸脘痞满.苔腻，脉濡数，治疗宜清热化湿，化浊，方选茵陈蒿汤（《伤寒论》）及甘露消毒丹（《温热经纬》）之类。'}, {'source': '脾胃湿热证', 'relation': '对应常见病及治疗方法：', 'target': '1、湿阻\n\n此由脾胃功能失调，运化失职，湿从内生，外湿侵犯，内湿与外湿互结化热而成湿阻，症见口苦粘腻，脉满数，治疗应清热化湿，方用连朴饮（《霍乱论》）或甘露消毒丹（《温热经纬》）。'}, {'source': '脾胃湿热证', 'relation': '有症状：', 'target': '脉濡数'}, {'source': '脾胃湿热证', 'relation': '有症状：', 'target': '舌红苔黄腻'}, {'source': '脾胃湿热证', 'relation': '有症状：', 'target': '汗出不解'}, {'source': '脾胃湿热证', 'relation': '有症状：', 'target': '或身热起伏'}, {'source': '脾胃湿热证', 'relation': '有症状：', 'target': '皮肤发痒'}, {'source': '脾胃湿热证', 'relation': '有症状：', 'target': '色泽鲜红如橘子色'}, {'source': '脾胃湿热证', 'relation': '有症状：', 'target': '或面目肌肤发黄'}, {'source': '脾胃湿热证', 'relation': '有症状：', 'target': '恶心呕吐'}, {'source': '脾胃湿热证', 'relation': '有症状：', 'target': '纳少厌食'}, {'source': '脾胃湿热证', 'relation': '有症状：', 'target': '大便溏泄不爽'}, {'source': '脾胃湿热证', 'relation': '有症状：', 'target': '尿少色黄'}, {'source': '脾胃湿热证', 'relation': '有症状：', 'target': '肢体困倦'}, {'source': '脾胃湿热证', 'relation': '有症状：', 'target': '脘腹胀满'}, {'source': '脾胃湿热证', 'relation': '的定义是', 'target': '是指湿热内蕴，脾胃失运，以脘腹痞胀，呕恶纳呆，肢体困重，便溏不爽，或面目发黄，或身热不扬，汗出热不解，渴不多饮，舌红苔黄腻，脉滑数等为常见症的证候。常见于湿阻、黄疸、水肿、鼓胀、痢疾、泄泻等疾病中。西医学中的霍乱、副霍乱、病毒性肝炎、肝硬化腹水、急性胃肠炎、细菌性痢疾等可见本证。'}]
